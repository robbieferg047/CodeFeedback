def BarChart(day, parameter, axis): #Specify the day of analysis, the parameter you want (% BW, etc), and the axis to plot on (Each parameter gets its own axis)
    data_chartlist = [] #List for t-test later
    for Sex in data_final['Sex'].dropna().unique(): #Iterate over males vs female
        print(Sex)
        data = data_final.loc[data_final['Sex'] == Sex] 
        data = data.loc[data['Date'] == day]
       
        #data = data.loc[data['Date'] <= day + 0.5] #Can include the other 12 hour bin if desired by uncommenting
        data_chart = pd.DataFrame(data[[parameter, 'Sex']])

        if Sex == "Male":
            col = "deeppink"
        else:
            col = "deepskyblue"

        sb.barplot(data_chart, x = data_chart['Sex'], 
                   y = parameter, color = col, errorbar = 'sd', ax = axis) #Using seaborn to plot barplot
        
        sb.stripplot(x = data_chart['Sex'], 
                     y = parameter, data = pd.DataFrame(data_chart[parameter]), color = col, alpha = 1, 
                     edgecolor = 'black', linewidth = 1, ax = axis) #Stripplot for individual data points
        data_chartlist.append(data_chart) #Appending a list for t-test
        data_chartlist_check = pd.concat(data_chartlist)
        
        if Sex == "Male":
            sp.probplot(data_chartlist_check['BW'], dist="norm", plot=ax3)
            print(data_chartlist_check)
        if Sex == "Female":
            data_chartlist_check = data_chartlist_check.loc[data_chartlist_check['Sex'] == "Female"]
            sp.probplot(data_chartlist_check['BW'], dist="norm", plot=ax4) #Checking normality

        ax3.set_title("Q-Q Plot" + f'{parameter}' +  'Males')
        ax4.set_title("Q-Q Plot" + f'{parameter}' +  'Females')
        
        ax3.legend()
        ax4.legend()

    data_chart = pd.concat(data_chartlist)
    data_chart = pd.DataFrame(data_chart)
    pairs = list(itertools.combinations(np.unique(data_chart['Sex']), 2)) #All the t-test pairs
   
    annotate = sn.Annotator(axis, pairs, plot = 'barplot', data= data_chart, x = "Sex", 
                            y = parameter, loc = 'inside', fontsize = 'small') #Using statannotations to annotate with t-test
    
    annotate.configure(test='t-test_welch', verbose = 3, text_format = 'star', 
                            alpha = 0.05) #Welch's because of equal variance concerns
    
    data_chart_check = pd.DataFrame()
    data_chart_check[parameter] = data_chart[parameter]
    print(data_chart_check)

    print("Day:", day, "Parameter:", parameter) #So you can see what you ran t-tests for in the terminal
    annotate.apply_and_annotate() #It should spit out p-values too

    ax2.set_ylim([80, 110]) #Need to set sensible ylims for BW chart, it looks ridiculous otherwise

    axis.set_title("Day: " + f'{day}' + ", " + " Parameter: " f'{parameter}')
    ax1.axvline(day, color='blue', linestyle='dashed')

